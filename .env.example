# === Databricks (primary backend) ===
DATABRICKS_HOST=https://dbc-XXXXX.cloud.databricks.com
DATABRICKS_TOKEN=dapi...
DATABRICKS_CATALOG=hack_nation
DATABRICKS_SCHEMA=india_medical

# === Databricks services ===
# From URL: /genie/rooms/<GENIE_SPACE_ID>
GENIE_SPACE_ID=
VECTOR_SEARCH_INDEX=hack_nation.india_medical.india_facilities_index
VECTOR_SEARCH_ENDPOINT=india-medical-vs

# === MLflow ===
MLFLOW_EXPERIMENT_PATH=/Shared/india-medical-agent
LLM_ENDPOINT=databricks-qwen3-next-80b-a3b-instruct

# === LLM fallback (optional) ===
OPENROUTER_API_KEY=

# === Unity Catalog model (serving) ===
UC_MODEL_NAME=hack_nation.india_medical.carecompass_agent

# === Referral: Twilio (optional; /referral/send uses real SMS if all are set) ===
# E.164 for TWILIO_FROM_NUMBER and recipient `to_phone` in API body / preview
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# === Facility enrichment: Tavily (optional; required for /enrichment/*) ===
TAVILY_API_KEY=
